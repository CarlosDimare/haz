#!/usr/bin/env node

// Cosito wrapper - delegates to the opencode binary
// This provides the cosito command while the package is still named opencode

const childProcess = require("child_process")
const fs = require("fs")
const path = require("path")

const scriptPath = fs.realpathSync(__filename)
const scriptDir = path.dirname(scriptPath)
const opencodeBin = path.join(scriptDir, "opencode")

if (!fs.existsSync(opencodeBin)) {
  console.error("opencode binary not found at", opencodeBin)
  process.exit(1)
}

const child = childProcess.spawn(opencodeBin, process.argv.slice(2), {
  stdio: "inherit",
})

child.on("error", (error) => {
  console.error(error.message)
  process.exit(1)
})

const forwardedSignals = ["SIGINT", "SIGTERM", "SIGHUP"]
const forwarders = {}
for (const signal of forwardedSignals) {
  forwarders[signal] = () => {
    try { child.kill(signal) } catch {}
  }
  process.on(signal, forwarders[signal])
}

child.on("exit", (code, signal) => {
  for (const signal of forwardedSignals) {
    process.removeListener(signal, forwarders[signal])
  }
  if (signal) {
    process.kill(process.pid, signal)
    return
  }
  process.exit(typeof code === "number" ? code : 0)
})
